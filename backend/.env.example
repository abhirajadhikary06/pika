# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30

# Database (Neon or local Postgres)
DATABASE_URL=postgresql://user:password@host:5432/pika?sslmode=require

# Celery / Redis (memory:// for local, Upstash for production)
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
# Production example:
# CELERY_BROKER_URL=rediss://default:TOKEN@HOST:6379
# CELERY_RESULT_BACKEND=rediss://default:TOKEN@HOST:6379

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Rate limiting storage (memory:// or Redis URL)
RATELIMIT_STORAGE_URI=memory://

# Uploads
UPLOAD_FOLDER=/tmp/pika_uploads

# Email delivery (works with SendGrid, Resend, SES, Mailgun, or any SMTP server)
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
